# GoHighLevel inbound webhook URL for the /booking lead form.
# VITE_-prefixed vars are inlined into the client bundle at build time, so
# this becomes visible in the browser's network tab — expected here, since
# GHL webhook URLs are write-only intake endpoints.
VITE_GHL_WEBHOOK_URL=

# Optional, server-only fallback used by app/api/submit-lead.js (the Vercel
# proxy Booking.jsx falls back to if the direct browser request is blocked by
# CORS). Not exposed to the client. If unset, the function reuses
# VITE_GHL_WEBHOOK_URL above instead.
# GHL_WEBHOOK_URL=
